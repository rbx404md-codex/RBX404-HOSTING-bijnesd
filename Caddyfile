bot.example.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
    @webhook path /webhook/rbx404
    handle @webhook {
        reverse_proxy bot:8080
    }
    handle /healthz {
        reverse_proxy bot:8080
    }
    handle {
        respond "not found" 404
    }
    log {
        output file /data/access.log {
            roll_size 10MB
            roll_keep 5
        }
        format console
    }
}